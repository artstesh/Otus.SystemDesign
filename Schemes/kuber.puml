@startuml
!theme cerulean-outline
<style>
  document {
    BackGroundColor #fff
  }
</style>
' === Внешний периметр ===
node "Cloudflare / CDN" {
  component "WAF" as waf
  component "DDoS Protection" as ddos
}

node "Load Balancer" as lb

' === Kubernetes Cluster ===
node "Kubernetes Cluster" {
  component "API Gateway (Ocelot)" as gateway
  component "Service Discovery (CoreDNS)" as dns

  frame "User Service" {
    component "Pod" as user_pod
  }
  frame "Ad Service" {
    component "Pod" as ad_pod
  }
  frame "Order Service" {
    component "Pod" as order_pod
  }
  frame "Payment Service" {
    component "Pod" as payment_pod
  }
  frame "Delivery Service" {
    component "Pod" as delivery_pod
  }
  frame "Notification Service" {
    component "Pod" as notif_pod
  }
  frame "Search Service" {
    component "Pod" as search_pod
  }

  database "Kafka" {
    component "Broker" as kafka
  }
}

node "External Services" {
  component "Payment Gateway" as pay_ext
  component "Maps API" as map_ext
}

' === Связи ===
Internet --> waf
waf --> lb
lb --> gateway

gateway --> dns
gateway --> user_pod
gateway --> ad_pod
gateway --> order_pod
gateway --> payment_pod
gateway --> delivery_pod
gateway --> notif_pod
gateway --> search_pod

user_pod --> ad_pod : gRPC
order_pod --> payment_pod : gRPC
order_pod --> delivery_pod : gRPC

ad_pod --> kafka : Kafka (pub)
order_pod --> kafka : Kafka (pub)
payment_pod --> kafka : Kafka (pub)
delivery_pod --> kafka : Kafka (pub)
kafka --> notif_pod : sub
kafka --> search_pod : sub

payment_pod --> pay_ext : REST
delivery_pod --> map_ext : REST

notif_pod --> Internet : WebSockets
@enduml
