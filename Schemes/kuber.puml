git@startuml
!theme cerulean-outline
<style>
  document {
    BackGroundColor #fff
  }
</style>

node "Kubernetes Cluster" {
  frame "Application Services" {
    component "Ad Service" as ad
    component "Search Service" as search
    component "User Service" as user
    component "Order Service" as order
    component "Payment Service" as payment
  }

  frame "Data Layer" {
    database "PostgreSQL Cluster" {
      component "Master" as pg_master
      component "Replica 1" as pg_replica1
      component "Replica 2" as pg_replica2
      component "PgBouncer" as pgbouncer
    }

    database "Elasticsearch Cluster" {
      component "Master Nodes" as es_master
      component "Data Nodes" as es_data
    }

    database "Redis Cluster" {
      component "Redis" as redis_master
    }

    database "Kafka Cluster" as kafka

    component "S3 Storage" as s3
    component "CDN" as cdn
  }
}

node "External" {
  component "Payment Gateway" as payext
  component "Maps API" as mapext
}

' Взаимодействия
ad --> pgbouncer : команды
ad --> redis_master : кэш
ad --> s3 : upload
ad --> kafka : события
search --> es_data : индексация
search <-- kafka : подписка
user --> pgbouncer
order --> pgbouncer
payment --> pgbouncer
payment --> payext
search --> redis_master : кэш результатов
cdn <-- s3 : origin
cdn --> Internet : клиенты
@enduml
